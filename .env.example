# Copy this file to `.env` and fill in the values, then rebuild (`npm run build`).
# Both values are public (they ship in the client bundle) — they are not secrets.
# See ANALYTICS.md for where to get them.

# Microsoft Clarity → Settings → Overview → "Clarity project id" (10 characters).
# Leave blank to disable Clarity (no script, no cookies).
VITE_CLARITY_PROJECT_ID=

# Cloudflare dashboard → your domain → Analytics & Logs → Web Analytics →
# add the site → copy the token from the <script data-cf-beacon='{"token":"..."}'> snippet.
# Leave blank to disable the beacon.
VITE_CF_BEACON_TOKEN=
